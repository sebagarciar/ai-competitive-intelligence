# YouTube Data API v3
# Get your free API key: https://console.cloud.google.com/apis/credentials
# Free tier: 10,000 quota units/day (sufficient for ~50-100 searches)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Webhose.io API
# Sign up for free tier: https://webhose.io/free-datasets
# Free tier: 1,000 requests/month
WEBHOSE_API_KEY=your_webhose_api_key_here

# Reddit API (PRAW) - SOCIAL LISTENING
# Create Reddit app: https://www.reddit.com/prefs/apps
# 1. Click "Create App" or "Create Another App"
# 2. Choose "script" type
# 3. Name it (e.g., "luxury-brand-intelligence")
# 4. Set redirect uri to http://localhost:8080
# Free tier: 60 requests/minute (very generous)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=luxury-brand-intelligence:v1.0

# Twitter/X Scraping - SOCIAL LISTENING (OPTIONAL, LEGACY)
# WARNING: Unofficial scraping, may break. Set to "true" to enable.
# Uses ntscraper (no API key needed but fragile)
# Prefer XAI_API_KEY below for reliable X data via Grok
TWITTER_ENABLED=false

# xAI (Grok) API — live X (Twitter) search via Grok
# Sign up: https://console.x.ai
# Grok has built-in access to X posts; no official Twitter API needed
# Leave blank to skip (Bluesky + Reddit will still run)
XAI_API_KEY=your_xai_api_key_here
